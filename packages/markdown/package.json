{
  "name": "@panorama-lab/markdown",
  "version": "0.2.5",
  "description": "A lightweight dialect for writing academic papers and representing parsed PDF papers in Markdown.",
  "homepage": "https://github.com/panorama-lab/markdown#readme",
  "bugs": {
    "url": "https://github.com/panorama-lab/markdown/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panorama-lab/markdown.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/exports/index.ts",
    "./pdf": "./src/exports/pdf.ts",
